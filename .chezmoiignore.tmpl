.vscode/

.oh-my-zsh/cache
.oh-my-zsh/cache/**
.oh-my-zsh/**/*.zwc

.zshrc.local.d/

# Hyprland Config - nur auf Arch Linux Laptops
{{ if not (and (eq .chezmoi.os "linux") (lookPath "pacman") (.chezmoi.kernel.osrelease | regexMatch ".*arch.*")) }}
.config/hypr/
{{ end }}

# Systemdateien (z.B. SDDM) - werden per .chezmoiscripts installiert, nie ins Home
system/
system/**

# Lockscreen-Rotation (hyprlock + SDDM) - nur auf Linux-Notebooks
{{ if not (and (eq .chezmoi.os "linux") .isLaptop) }}
.config/systemd/user/lockscreen-rotate.service
.config/systemd/user/lockscreen-rotate.timer
.config/systemd/user/timers.target.wants/lockscreen-rotate.timer
{{ end }}

# Persönliche Bilder und Wallpaper - immer ignorieren
.config/hypr/images/
.config/rofi/images/

{{ if not (lookPath "kitty") }}
.config/kitty/
{{ end }}

# Wayland Desktop Konfigurationen - nur auf Arch Linux Laptops
{{ if not (and (eq .chezmoi.os "linux") (lookPath "pacman") (.chezmoi.kernel.osrelease | regexMatch ".*arch.*")) }}
.config/hypr/
.config/waybar/
.config/rofi/
.config/mako/
.config/wlogout/
.config/systemd/user/waybar*.service
.config/systemd/user/hypr*.service
{{ end }}
